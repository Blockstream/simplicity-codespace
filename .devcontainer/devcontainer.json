{
    "name": "Simplicity Workshop",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "SIMPLICITYHL_REPO": "https://github.com/BlockstreamResearch/SimplicityHL.git",
            "HAL_SIMPLICITY_REPO": "https://github.com/BlockstreamResearch/hal-simplicity.git"
        },
        "options": [
            "--platform=linux/amd64"
        ]
    },
    "runArgs": [
        "--platform=linux/amd64"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "Blockstream.simplicityhl"
            ]
        }
    },
    "postCreateCommand": "chmod +x /usr/local/bin/simc || true"
}
